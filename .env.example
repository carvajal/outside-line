# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every key maps 1:1 to a field on Settings in src/outside_line/config.py,
# which carries the full rationale per knob. Blank optional keys are fine.

# ============================================================
# Hard-required (production boots refuse to start without these
# when ENVIRONMENT != development — see require_boot_credentials)
# ============================================================

OPENAI_API_KEY=

# Twilio uses API-Key auth (SK + secret + account SID); the Auth Token is
# additionally required to validate X-Twilio-Signature on the webhooks.
TWILIO_ACCOUNT_SID=AC...            # console homepage (not secret, but required)
TWILIO_API_KEY_SID=SK...            # API key SID
TWILIO_API_KEY_SECRET=              # API key secret (shown once at creation)
TWILIO_AUTH_TOKEN=                  # enables webhook signature validation
TWILIO_PHONE_NUMBER=+1555...        # the mainline DID

PUBLIC_BASE_URL=                    # https://<your-app-domain> — set after deploy

# ============================================================
# Agent identity + locale
# ============================================================

# The name the agent answers to. Feeds the persona prompt and the
# post-call summary / memory-merge prompts.
AGENT_NAME=Alex
# IANA timezone for the agent's date awareness and search freshness anchor.
# AGENT_TIMEZONE=America/New_York

# ============================================================
# OpenAI model knobs (all optional — defaults in config.py)
# ============================================================

# OPENAI_REALTIME_MODEL=gpt-realtime-2.1     # pin a dated snapshot for reproducibility
# OPENAI_REALTIME_VOICE=cedar
# OPENAI_REALTIME_OUTPUT_GAIN=0.8
# OPENAI_REALTIME_OUTPUT_SPEED=1.0
# OPENAI_REALTIME_REASONING_EFFORT=high      # minimal | low | medium | high | xhigh
# OPENAI_SEARCH_MODEL=gpt-5.4-mini           # search_web + case_brief_lookup workers
# Caller-speech transcription (side channel; does NOT gate the agent's
# reply — ADR 0024). Leave the language blank to auto-detect per utterance.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_TRANSCRIPTION_LANGUAGE=en
# SEARCH_WEB_TIMEOUT_S=15.0

# ============================================================
# Realtime VAD + playout tuning (optional)
# ============================================================

# REALTIME_VAD_THRESHOLD=0.7
# REALTIME_VAD_PREFIX_PADDING_MS=300
# REALTIME_VAD_SILENCE_DURATION_MS=1500
# PLAYOUT_MARK_GRACE_S=1.5

# ============================================================
# Call recording (OFF by default — recording calls has
# jurisdiction-specific consent rules; see README "Lawful use")
# ============================================================

# RECORDINGS_ENABLED=false
# RECORDING_DISCLOSURE_ENABLED=true   # speak "This call may be recorded." first

# ============================================================
# DTMF acceptance gate
# ============================================================

# Lead + trail pause (seconds) around the DTMF '1' that accepts the call
# on carriers that require a digit press. 1..60 (Twilio <Pause> range).
# Per-caller skip flag: ./scripts/callers.py skip-gate <phone> on|off
# DTMF_GATE_SECONDS=20

# ============================================================
# Telegram (only needed for the call/message bridge)
# ============================================================

TELEGRAM_API_ID=                    # https://my.telegram.org/apps
TELEGRAM_API_HASH=                  # same place
TELEGRAM_PHONE_NUMBER=+1555...      # the agent account's phone
# TELEGRAM_SESSION_PATH=data/sessions/outside-line.session
# TELEGRAM_SIDECAR_SOCKET_PATH=data/telegram_sidecar.sock

# ============================================================
# Directlines (dedicated DID → one contact; ADR 0013)
# ============================================================

# DIRECTLINES_PATH=data/directline_numbers.json
# DIRECTLINE_RING_TIMEOUT_S=70
# DIRECTLINE_WAIT_MESSAGE_ENABLED=true
# RING_AUDIO_KIND=hum                 # hum | ringback
# BRIDGE_STALL_TEAR_DOWN_S=10         # 0 = disable the stall detector

# ============================================================
# Caller registry + memory
# ============================================================

# CALLERS_PATH=data/callers.json
# CALLER_MEMORY_DIR=data/memory
# CALLER_MEMORY_MIN_UTTERANCES=3
# CALLER_MEMORY_MODEL=gpt-5.4-mini

# ============================================================
# Per-call report email (ADR 0022; fail-open — blank disables)
# ============================================================

# CALLER_ALERTS_ENABLED=true
CALLER_ALERTS_EMAIL_TO=             # recipient (e.g. you@example.com)
CALLER_ALERTS_RESEND_API_KEY=       # https://resend.com/api-keys
# CALLER_ALERTS_EMAIL_FROM='Outside Line <onboarding@resend.dev>'  # default works without DNS

# ============================================================
# Case-brief lookup tool (optional feature)
# ============================================================

# CASE_BRIEF_PATH=data/case_brief/brief.md   # see docs/examples/case-brief.example.md
# CASE_BRIEF_DOCKET_FEED_URL=                # blank = answer from the brief alone
# CASE_BRIEF_LOOKUP_TIMEOUT_S=10.0

# ============================================================
# Runtime
# ============================================================

LOG_LEVEL=INFO
ENVIRONMENT=development             # anything else arms require_boot_credentials
# SIDECAR_DEBUG_CRASH=1             # debug only: enables POST /debug/crash-sidecar (ADR 0017)

# ============================================================
# Operator-script-only keys (read by scripts/, not by the app)
# ============================================================

# DEV_NGROK_DOMAIN=                  # reserved ngrok domain for `dev_mode local`
# RAILWAY_APP_DOMAIN=                # the deployed app's public host
